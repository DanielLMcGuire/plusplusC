#include <def.h>
#include <cio.h>
#include <str.h>
#include <parr.h>
#include <class.pph>
#include <app.pph>

CLASS(LeakTest, Application)
{
    BASE(Application)
};

CLASS_EXPORT(LeakTest);

int program(parr_t csArgs)
{
    (void)csArgs;

    const char *fakeArgv[] = { "/usr/local/bin/myapp" };
    parr_t args = parr_new((const void **)fakeArgv, 1);

    for (int i = 0; i < 200000; i++)
    {
        LeakTest *demo = NEW(LeakTest);
        Application *app = AS(Application, demo);
        CALL1(app, parse_args, &args);
        REMOVE(demo);
    }

    parr_free(&args);

    puts("leak_test: completed 200000 iterations OK", SIOOUT);
    return 0;
}

CLASS_INFO(LeakTest, Application);

CONSTRUCTOR(LeakTest)
{
    SUPER_CTOR(self, Application);
}
DECONSTRUCTOR(LeakTest)
{
    SUPER_DTOR(self, Application);
}
