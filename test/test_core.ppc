static bool test_dstr_growth(void)
{
    dstr_t s = dstr_new("");
    ASSERT(s.len == 0 && s.cap == 15);

    for (int i = 0; i < 100; i++)
        dstr_append(&s, "0123456789");
    ASSERT(s.len == 1000);
    ASSERT(s.cap >= 1000);
    ASSERT(s.data[0] == '0' && s.data[999] == '9' && s.data[1000] == '\0');
    dstr_free(&s);

    dstr_t c = dstr_new("");
    for (int i = 0; i < 200; i++)
        dstr_append_char(&c, (char)('a' + (i % 26)));
    ASSERT(c.len == 200);
    ASSERT(c.data[0] == 'a' && c.data[199] == (char)('a' + (199 % 26)));
    ASSERT(c.data[200] == '\0');
    dstr_free(&c);

    dstr_t l = dstr_new("this string is longer than fifteen");
    ASSERT(l.len == strlen("this string is longer than fifteen"));
    ASSERT(l.cap == l.len * 2);
    dstr_free(&l);
    return true;
}

static bool test_dstr_numbers(void)
{
    dstr_t n = dstr_new("");
    dstr_append_int(&n, 0);
    dstr_append_char(&n, ',');
    dstr_append_int(&n, -5);
    dstr_append_char(&n, ',');
    dstr_append_int(&n, 2147483647);
    dstr_append_char(&n, ',');
    dstr_append_int(&n, -2147483647 - 1);
    ASSERT_STR_EQ(n.data, "0,-5,2147483647,-2147483648");
    dstr_free(&n);

    dstr_t z = dstr_new("");
    dstr_append_size_t(&z, 0);
    dstr_append_char(&z, ',');
    dstr_append_size_t(&z, 7);
    dstr_append_char(&z, ',');
    dstr_append_size_t(&z, (size_t)1234567890123ULL);
    ASSERT_STR_EQ(z.data, "0,7,1234567890123");
    dstr_free(&z);
    return true;
}

static bool test_dstr_null_guards(void)
{
    dstr_t s = dstr_new("keep");

    dstr_append(NULL, "x");
    dstr_append(&s, NULL);
    dstr_append_char(NULL, 'x');
    dstr_append_int(NULL, 1);
    dstr_append_size_t(NULL, 1);
    ASSERT_STR_EQ(s.data, "keep");

    dstr_t none = {0, 0, 0};
    dstr_append(&none, "x");
    dstr_append_char(&none, 'x');
    dstr_append_int(&none, 1);
    dstr_append_size_t(&none, 1);
    ASSERT(none.data == NULL && none.len == 0);

    dstr_free(NULL);
    dstr_free(&none);
    dstr_free(&s);
    dstr_free(&s);
    ASSERT(s.data == NULL);

    dstr_t from_null = dstr_new(NULL);
    ASSERT(from_null.data != NULL && from_null.len == 0 && from_null.data[0] == '\0');
    dstr_append(&from_null, "ok");
    ASSERT_STR_EQ(from_null.data, "ok");
    dstr_free(&from_null);
    return true;
}

static bool test_iarr_ops(void)
{
    const int init[3] = {10, 20, 30};
    iarr_t a = iarr_new(init, 3);
    ASSERT(a.len == 3 && a.data[0] == 10 && a.data[2] == 30);

    int more[40];
    for (int i = 0; i < 40; i++)
        more[i] = i;
    iarr_append(&a, more, 40);
    ASSERT(a.len == 43 && a.cap >= 43);
    ASSERT(a.data[3] == 0 && a.data[42] == 39 && a.data[0] == 10);

    iarr_append(&a, more, 2);
    ASSERT(a.len == 45 && a.data[44] == 1);

    size_t before = a.len;
    iarr_append(NULL, more, 1);
    iarr_append(&a, NULL, 1);
    iarr_append(&a, more, 0);
    ASSERT(a.len == before);

    iarr_t empty = {0, 0, 0};
    iarr_append(&empty, more, 1);
    iarr_append_val(&empty, 1);
    ASSERT(empty.data == NULL);

    iarr_t e2 = iarr_new(NULL, 0);
    ASSERT(e2.len == 0 && e2.data != NULL);
    iarr_free(&e2);
    iarr_free(&a);
    iarr_free(&a);
    iarr_free(NULL);
    return true;
}

static bool test_parr_ops(void)
{
    const char *init[2] = {"a", "b"};
    parr_t p = parr_new((const void **)init, 2);
    ASSERT(p.len == 2);
    ASSERT_STR_EQ((const char *)p.data[1], "b");

    const char *many[40];
    for (int i = 0; i < 40; i++)
        many[i] = "m";
    parr_append(&p, (const void **)many, 40);
    ASSERT(p.len == 42 && p.cap >= 42);
    ASSERT_STR_EQ((const char *)p.data[41], "m");

    for (int i = 0; i < 100; i++)
        parr_append_val(&p, (void *)"v");
    ASSERT(p.len == 142);

    size_t before = p.len;
    parr_append(NULL, (const void **)many, 1);
    parr_append(&p, NULL, 1);
    parr_append(&p, (const void **)many, 0);
    parr_append_val(NULL, NULL);
    ASSERT(p.len == before);

    parr_t none = {0, 0, 0};
    parr_append(&none, (const void **)many, 1);
    parr_append_val(&none, (void *)"x");
    ASSERT(none.data == NULL);

    parr_free(&p);
    parr_free(&p);
    parr_free(NULL);
    ASSERT(p.data == NULL);
    return true;
}

static bool test_parr_strings(void)
{
    parr_t cs = parr_new(NULL, 0);
    parr_append_cstr(&cs, "alpha");
    parr_append_cstr(&cs, "");
    parr_append_cstr(&cs, "gamma");
    parr_append_cstr(NULL, "ignored");
    ASSERT(cs.len == 3);
    parr_append_cstr(&cs, NULL);
    ASSERT(cs.len == 4);
    ASSERT_STR_EQ((const char *)cs.data[3], "");
    free(cs.data[3]);
    cs.len = 3;
    ASSERT_STR_EQ((const char *)cs.data[0], "alpha");
    ASSERT_STR_EQ((const char *)cs.data[1], "");

    dstr_t d = dstr_new("delta");
    parr_t ds = parr_new(NULL, 0);
    parr_append_dstr(&ds, &d);
    parr_append_dstr(&ds, NULL);
    dstr_t nodata = {0, 0, 0};
    parr_append_dstr(&ds, &nodata);
    parr_append_dstr(NULL, &d);
    ASSERT(ds.len == 3);
    ASSERT_STR_EQ(((dstr_t *)ds.data[0])->data, "delta");
    ASSERT_STR_EQ(((dstr_t *)ds.data[1])->data, "");
    ASSERT_STR_EQ(((dstr_t *)ds.data[2])->data, "");

    parr_t conv = parr_c_strings_to_dstr(&cs);
    ASSERT(conv.len == 3);
    ASSERT_STR_EQ(((dstr_t *)conv.data[2])->data, "gamma");

    parr_t back = parr_dstr_to_c_strings(&conv);
    ASSERT(back.len == 3);
    ASSERT_STR_EQ((const char *)back.data[0], "alpha");

    parr_t odd = parr_new(NULL, 0);
    parr_append_val(&odd, NULL);
    parr_append_val(&odd, &nodata);
    parr_t odd_cs = parr_dstr_to_c_strings(&odd);
    ASSERT(odd_cs.len == 2);
    ASSERT_STR_EQ((const char *)odd_cs.data[0], "");
    ASSERT_STR_EQ((const char *)odd_cs.data[1], "");
    parr_free_c_strings(&odd_cs);
    parr_free(&odd);

    parr_t e1 = parr_c_strings_to_dstr(NULL);
    parr_t e2 = parr_dstr_to_c_strings(NULL);
    ASSERT(e1.data == NULL && e2.data == NULL);

    parr_free_c_strings(&back);
    parr_free_dstr(&conv);
    parr_free_dstr(&ds);
    parr_free_c_strings(&cs);
    dstr_free(&d);

    parr_t holes = parr_new(NULL, 0);
    parr_append_val(&holes, NULL);
    parr_free_c_strings(&holes);
    parr_t holes2 = parr_new(NULL, 0);
    parr_append_val(&holes2, NULL);
    parr_free_dstr(&holes2);
    parr_free_c_strings(NULL);
    parr_free_dstr(NULL);
    parr_t emp = {0, 0, 0};
    parr_free_c_strings(&emp);
    parr_free_dstr(&emp);
    return true;
}

static bool test_mem_functions(void)
{
    char buf[16] = "abcdefghij";

    memmove(buf + 2, buf, 5);
    ASSERT(memcmp(buf, "ababcdehij", 10) == 0);

    memcpy(buf, "abcdefghij", 10);
    memmove(buf, buf + 3, 5);
    ASSERT(memcmp(buf, "defghfghij", 10) == 0);

    ASSERT(memmove(buf, buf, 4) == buf);
    ASSERT(memmove(buf, "zz", 0) == buf);
    ASSERT(buf[0] == 'd');

    ASSERT(memcmp("abc", "abc", 3) == 0);
    ASSERT(memcmp("abc", "abd", 3) < 0);
    ASSERT(memcmp("abd", "abc", 3) > 0);
    ASSERT(memcmp("a\xff", "a\x01", 2) > 0);
    ASSERT(memcmp("abc", "xyz", 0) == 0);

    memset(buf, 'q', 8);
    ASSERT(buf[0] == 'q' && buf[7] == 'q' && buf[8] != 'q');
    return true;
}

static bool test_str_functions(void)
{
    ASSERT(strlen("") == 0);
    ASSERT(strlen("hello") == 5);
    ASSERT(strcmp("a", "a") == 0);
    ASSERT(strcmp("a", "b") < 0);
    ASSERT(strcmp("b", "a") > 0);
    ASSERT(strcmp("ab", "a") > 0);
    ASSERT(strcmp("a", "ab") < 0);
    return true;
}

#include "test_fmt.inl"

#if defined(__linux__)

static int call_vprintf(unsigned int stream, const char *fmt, ...)
{
    va_list ap;
    va_start(ap, fmt);
    int r = vprintf(fmt, ap, stream);
    va_end(ap);
    return r;
}

static bool test_cio_output(void)
{
    char out[4096];
    capture_t cap;

    ASSERT(capture_begin(&cap, 1));
    int r_print   = print("hi", SIOOUT);
    int r_null    = print(NULL, SIOOUT);
    int r_empty   = print("", SIOOUT);
    int r_puts    = puts("line", SIOOUT);
    int r_pnull   = puts(NULL, SIOOUT);
    int r_putc    = putchar('z', SIOOUT);
    dstr_t d = dstr_new("ds");
    int r_pds     = print_ds(&d, SIOOUT);
    int r_putsds  = puts_ds(&d, SIOOUT);
    dstr_free(&d);
    capture_end(&cap, out, sizeof(out));

    ASSERT(r_print == 1 && r_null == -1 && r_empty == 1);
    ASSERT(r_puts == '\n' && r_pnull == -1 && r_putc == 'z');
    ASSERT(r_pds == 1 && r_putsds == '\n');
    ASSERT_STR_EQ(out, "hiline\nzdsds\n");

    ASSERT(capture_begin(&cap, 2));
    print("e1", SIOERR);
    puts("e2", SIOERR);
    putchar('!', SIOERR);
    capture_end(&cap, out, sizeof(out));
    ASSERT_STR_EQ(out, "e1e2\n!");
    return true;
}

static bool test_cio_parr_printing(void)
{
    char out[256];
    capture_t cap;

    parr_t cs = parr_new(NULL, 0);
    parr_append_cstr(&cs, "a");
    parr_append_val(&cs, NULL);
    parr_append_cstr(&cs, "b");

    dstr_t x = dstr_new("x");
    dstr_t nodata = {0, 0, 0};
    parr_t ds = parr_new(NULL, 0);
    parr_append_val(&ds, &x);
    parr_append_val(&ds, NULL);
    parr_append_val(&ds, &nodata);

    parr_t empty = parr_new(NULL, 0);

    ASSERT(capture_begin(&cap, 1));
    print_parr_c_string(&cs, SIOOUT);
    print_parr_dstr(&ds, SIOOUT);
    print_parr_c_string(&empty, SIOOUT);
    print_parr_dstr(&empty, SIOOUT);
    print_parr_c_string(NULL, SIOOUT);
    print_parr_dstr(NULL, SIOOUT);
    capture_end(&cap, out, sizeof(out));

    ASSERT_STR_EQ(out, "[\"a\", \"\", \"b\"]\n[\"x\", \"\", \"\"]\n[]\n[]\n");

    parr_free_c_strings(&cs);
    parr_free(&ds);
    parr_free(&empty);
    dstr_free(&x);
    return true;
}

static bool test_cio_printf_sizes(void)
{
    static char big[3000];
    for (int i = 0; i < 2999; i++)
        big[i] = (char)('a' + (i % 26));
    big[2999] = '\0';

    static char out[4096];
    capture_t cap;

    ASSERT(capture_begin(&cap, 1));
    int r_big = printf("%s", big);
    int r_small = printf("<%d>", 42);
    int r_v = call_vprintf(SIOOUT, "[%s]", "v");
    capture_end(&cap, out, sizeof(out));

    ASSERT(r_big == 2999 && r_small == 4 && r_v == 3);
    ASSERT(strlen(out) == 2999 + 4 + 3);
    ASSERT(memcmp(out, big, 2999) == 0);
    ASSERT_STR_EQ(out + 2999, "<42>[v]");

    ASSERT(capture_begin(&cap, 2));
    call_vprintf(SIOERR, "err%d", 1);
    capture_end(&cap, out, sizeof(out));
    ASSERT_STR_EQ(out, "err1");
    return true;
}
#endif /* __linux__ */

static bool test_mutex_validation(void)
{
    mutex_t m;
    ASSERT(mutex_init(NULL, MUTEX_PLAIN) == MUTEX_ERROR);
    ASSERT(mutex_init(&m, 99) == MUTEX_ERROR);
    ASSERT(mutex_init(&m, -1) == MUTEX_ERROR);
    ASSERT(mutex_create(77) == NULL);

    ASSERT(mutex_destroy(NULL) == MUTEX_ERROR);
    ASSERT(mutex_lock(NULL) == MUTEX_ERROR);
    ASSERT(mutex_trylock(NULL) == MUTEX_ERROR);
    ASSERT(mutex_unlock(NULL) == MUTEX_ERROR);
    ASSERT(!mutex_is_locked(NULL));
    ASSERT(!mutex_is_owned_by_current_thread(NULL));
    ASSERT(mutex_get_owner(NULL) == 0);
    ASSERT(mutex_get_count(NULL) == 0);
    mutex_free(NULL);
    return true;
}

static bool test_mutex_plain(void)
{
    mutex_t *m = mutex_create(MUTEX_PLAIN);
    ASSERT(m != NULL);
    ASSERT(!mutex_is_locked(m));

    ASSERT(mutex_lock(m) == MUTEX_SUCCESS);
    ASSERT(mutex_is_locked(m));
    ASSERT(mutex_is_owned_by_current_thread(m));
    ASSERT(mutex_get_owner(m) == (long)thread_current_id() || mutex_get_owner(m) != 0);
    ASSERT(mutex_get_count(m) == 1);
    ASSERT(mutex_trylock(m) == MUTEX_BUSY);
    ASSERT(mutex_destroy(m) == MUTEX_BUSY);

    ASSERT(mutex_unlock(m) == MUTEX_SUCCESS);
    ASSERT(!mutex_is_locked(m));
    ASSERT(mutex_get_count(m) == 0);
    ASSERT(mutex_unlock(m) == MUTEX_EPERM);

    ASSERT(mutex_trylock(m) == MUTEX_SUCCESS);
    ASSERT(mutex_unlock(m) == MUTEX_SUCCESS);
    mutex_free(m);
    return true;
}

static bool test_mutex_recursive(void)
{
    mutex_t m;
    ASSERT(mutex_init(&m, MUTEX_RECURSIVE) == MUTEX_SUCCESS);

    ASSERT(mutex_lock(&m) == MUTEX_SUCCESS);
    ASSERT(mutex_lock(&m) == MUTEX_SUCCESS);
    ASSERT(mutex_trylock(&m) == MUTEX_SUCCESS);
    ASSERT(mutex_get_count(&m) == 3);

    ASSERT(mutex_unlock(&m) == MUTEX_SUCCESS);
    ASSERT(mutex_unlock(&m) == MUTEX_SUCCESS);
    ASSERT(mutex_is_locked(&m));
    ASSERT(mutex_unlock(&m) == MUTEX_SUCCESS);
    ASSERT(!mutex_is_locked(&m));

    ASSERT(mutex_lock(&m) == MUTEX_SUCCESS);
    m.count = UINT32_MAX;
    ASSERT(mutex_lock(&m) == MUTEX_ERROR);
    ASSERT(mutex_trylock(&m) == MUTEX_ERROR);
    m.count = 1;
    ASSERT(mutex_unlock(&m) == MUTEX_SUCCESS);

    ASSERT(mutex_destroy(&m) == MUTEX_SUCCESS);
    return true;
}

static bool test_mutex_errorcheck(void)
{
    mutex_t m = MUTEX_ERRORCHECK_INIT;

    ASSERT(mutex_lock(&m) == MUTEX_SUCCESS);
    ASSERT(mutex_lock(&m) == MUTEX_EDEADLK);
    ASSERT(mutex_trylock(&m) == MUTEX_EDEADLK);
    ASSERT(mutex_unlock(&m) == MUTEX_SUCCESS);

    ASSERT(mutex_trylock(&m) == MUTEX_SUCCESS);
    ASSERT(mutex_unlock(&m) == MUTEX_SUCCESS);
    return true;
}

static int g_guard_value = 0;

static bool test_mutex_scoped_macros(void)
{
    mutex_t m = MUTEX_INIT;

    MUTEX_GUARD(&m)
    {
        ASSERT(mutex_is_owned_by_current_thread(&m));
        g_guard_value = 1;
    }
    ASSERT(!mutex_is_locked(&m));
    ASSERT(g_guard_value == 1);

    {
        MUTEX_SCOPED(&m);
        ASSERT(mutex_is_locked(&m));
    }
    ASSERT(!mutex_is_locked(&m));

    mutex_t recursive = MUTEX_RECURSIVE_INIT;
    ASSERT(mutex_lock(&recursive) == MUTEX_SUCCESS);
    ASSERT(mutex_unlock(&recursive) == MUTEX_SUCCESS);
    return true;
}

#define CONTEND_THREADS 8
#define CONTEND_ITERS   60000

typedef struct
{
    crt_lock_t lock;
    long counter;
} contended_t;

static void *contend_worker(void *arg)
{
    contended_t *c = (contended_t *)arg;
    for (int i = 0; i < CONTEND_ITERS; i++)
    {
        __crt_lock_acquire(&c->lock);
        long v = c->counter;
        if ((i & 1023) == 0)
            thread_yield();
        c->counter = v + 1;
        __crt_lock_release(&c->lock);
    }
    return NULL;
}

static bool test_crt_lock_contention(void)
{
    contended_t c;
    __crt_lock_init(&c.lock);
    c.counter = 0;

    thread_t t[CONTEND_THREADS];
    for (int i = 0; i < CONTEND_THREADS; i++)
        ASSERT(thread_create(&t[i], contend_worker, &c, NULL) == THREAD_SUCCESS);
    for (int i = 0; i < CONTEND_THREADS; i++)
        ASSERT(thread_join(t[i], NULL) == THREAD_SUCCESS);
    ASSERT(c.counter == (long)CONTEND_THREADS * CONTEND_ITERS);

    ASSERT(__crt_lock_tryacquire(&c.lock));
    ASSERT(!__crt_lock_tryacquire(&c.lock));
    __crt_lock_release(&c.lock);
    return true;
}

static bool test_clock(void)
{
    u64 a = clock_monotonic_ns();
    ASSERT(a > 0);
    thread_sleep_ms(25);
    u64 b = clock_monotonic_ns();
    ASSERT(b >= a + 20ull * 1000000ull);

    u64 ms1 = clock_monotonic_ms();
    thread_sleep_ms(5);
    u64 ms2 = clock_monotonic_ms();
    ASSERT(ms2 >= ms1);
    ASSERT(ms1 >= a / 1000000ull);
    return true;
}

#if defined(__linux__)

static void h_dot(void) { putchar('.', SIOOUT); }
static void h_a(void)   { putchar('A', SIOOUT); }
static void h_b(void)   { putchar('B', SIOOUT); }
static void h_c(void)   { putchar('C', SIOOUT); }

static int child_atexit_fill(void *arg)
{
    (void)arg;
    if (atexit(NULL) != -1)
        return 10;

    int count = 0;
    if (atexit(h_a) != 0) return 11;
    count++;
    if (atexit(h_b) != 0) return 11;
    count++;
    if (atexit(h_c) != 0) return 11;
    count++;
    while (atexit(h_dot) == 0)
        count++;
    if (count != MAX_ATEXIT_FUNCS)
        return 12;
    return 0;
}

static bool test_atexit_order_and_limit(void)
{
    static char out[512];
    capture_t cap;
    ASSERT(capture_begin(&cap, 1));
    int st = run_in_child(child_atexit_fill, NULL);
    capture_end(&cap, out, sizeof(out));

    ASSERT(st == 0);
    ASSERT(strlen(out) == (size_t)(MAX_ATEXIT_FUNCS - 3 + 3));
    ASSERT_STR_EQ(out + (MAX_ATEXIT_FUNCS - 3), "CBA");
    ASSERT(out[0] == '.' && out[MAX_ATEXIT_FUNCS - 4] == '.');
    return true;
}

static int child_exit_code(void *arg)
{
    (void)arg;
    atexit(h_a);
    exit(7);
    return 0;
}

static int child_underscore_exit(void *arg)
{
    (void)arg;
    atexit(h_a);
    _exit(42);
    return 0;
}

static int child_underscore_Exit(void *arg)
{
    (void)arg;
    atexit(h_a);
    _Exit(43);
    return 0;
}

static bool test_exit_variants(void)
{
    static char out[64];
    capture_t cap;

    ASSERT(capture_begin(&cap, 1));
    int st = run_in_child(child_exit_code, NULL);
    capture_end(&cap, out, sizeof(out));
    ASSERT(st == 7);
    ASSERT_STR_EQ(out, "A");

    ASSERT(capture_begin(&cap, 1));
    st = run_in_child(child_underscore_exit, NULL);
    capture_end(&cap, out, sizeof(out));
    ASSERT(st == 42);
    ASSERT_STR_EQ(out, "");

    ASSERT(capture_begin(&cap, 1));
    st = run_in_child(child_underscore_Exit, NULL);
    capture_end(&cap, out, sizeof(out));
    ASSERT(st == 43);
    ASSERT_STR_EQ(out, "");
    return true;
}

static void *exit_from_thread(void *arg)
{
    (void)arg;
    exit(9);
    return NULL;
}

static void h_reenter(void)
{
    thread_t t;
    thread_create(&t, exit_from_thread, NULL, NULL);
    thread_sleep_ms(150);
    putchar('R', SIOOUT);
}

static int child_reentrant_exit(void *arg)
{
    (void)arg;
    atexit(h_reenter);
    exit(7);
    return 0;
}

static bool test_exit_reentrancy_guard(void)
{
    static char out[16];
    capture_t cap;
    ASSERT(capture_begin(&cap, 1));
    int st = run_in_child(child_reentrant_exit, NULL);
    capture_end(&cap, out, sizeof(out));

    ASSERT(st == 7);
    ASSERT_STR_EQ(out, "R");
    return true;
}

static void h_main_exit(void) { putchar('M', SIOOUT); }

static int child_main_thread_exit(void *arg)
{
    (void)arg;
    atexit(h_main_exit);
    thread_exit(NULL);
    return 55;
}

static bool test_thread_exit_main(void)
{
    static char out[16];
    capture_t cap;
    ASSERT(capture_begin(&cap, 1));
    int st = run_in_child(child_main_thread_exit, NULL);
    capture_end(&cap, out, sizeof(out));
    ASSERT(st == 0);
    ASSERT_STR_EQ(out, "M");
    return true;
}

static void *exit_with_value(void *arg)
{
    thread_exit(arg);
    return (void *)0xdead;
}

static void *noop_thread(void *arg) { return arg; }

static bool test_thread_validation_and_exit(void)
{
    thread_t t;
    ASSERT(thread_create(NULL, noop_thread, NULL, NULL) == THREAD_INVAL);
    ASSERT(thread_create(&t, NULL, NULL, NULL) == THREAD_INVAL);

    ASSERT(thread_join(NULL, NULL) == THREAD_INVAL);
    ASSERT(thread_join(thread_self(), NULL) == THREAD_DEADLK);
    ASSERT(thread_detach(NULL) == THREAD_INVAL);
    ASSERT(thread_detach(thread_self()) == THREAD_INVAL);
    ASSERT(thread_id(NULL) == 0);
    ASSERT(thread_equal(thread_self(), thread_self()));

    ASSERT(thread_create(&t, exit_with_value, (void *)5, NULL) == THREAD_SUCCESS);
    void *rv = NULL;
    ASSERT(thread_join(t, &rv) == THREAD_SUCCESS);
    ASSERT(rv == (void *)5);

    thread_attr_t at = THREAD_ATTR_INIT;
    ASSERT(thread_create(&t, noop_thread, NULL, &at) == THREAD_SUCCESS);
    ASSERT(thread_create(&t, noop_thread, NULL, NULL) == THREAD_SUCCESS);
    ASSERT(thread_detach(t) == THREAD_SUCCESS);
    ASSERT(thread_detach(t) == THREAD_INVAL);
    thread_sleep_ms(30);
    return true;
}

static bool test_tls_key_validation(void)
{
    ASSERT(tls_key_create(NULL, NULL) == THREAD_INVAL);
    ASSERT(tls_key_delete(TLS_KEYS_MAX) == THREAD_INVAL);
    ASSERT(tls_key_delete(TLS_KEYS_MAX + 100) == THREAD_INVAL);
    return true;
}

static bool test_thread_stack_too_large(void)
{
    thread_t t = (thread_t)1;
    thread_attr_t at = { (size_t)1 << 46, false };
    ASSERT(thread_create(&t, noop_thread, NULL, &at) == THREAD_NOMEM);
    return true;
}

static int child_thread_limit(void *arg)
{
    (void)arg;
    if (syscall(__NR_setresuid, 65534L, 65534L, 0L) != 0)
        return 77;

    unsigned long lim[2] = {1, 1};
    long rl = syscall(__NR_setrlimit, 6L /* RLIMIT_NPROC */, (long)lim);

    thread_t t = NULL;
    int rc = thread_create(&t, noop_thread, NULL, NULL);

    syscall(__NR_setresuid, 0L, 0L, 0L);
    if (rl != 0)
        return 77;
    if (rc == THREAD_SUCCESS)
    {
        thread_join(t, NULL);
        return 78;
    }
    return (rc == THREAD_NOMEM) ? 0 : 79;
}

static bool test_thread_create_clone_failure(void)
{
    int st = run_in_child_quiet(child_thread_limit, NULL);
    if (st == 77)
    {
        printf("  (skipped: needs root to drop privileges)\n");
        return true;
    }
    ASSERT(st == 0);
    return true;
}

static volatile int g_got_usr1 = 0;
static void on_usr1(int s) { (void)s; g_got_usr1 = 1; }

typedef struct { long pid; long tid; } kick_t;

static void *kick_thread(void *arg)
{
    kick_t *k = (kick_t *)arg;
    thread_sleep_ms(30);
    syscall(__NR_tgkill, k->pid, k->tid, 10L /* SIGUSR1 */);
    return NULL;
}

static bool test_sleep_resumes_after_signal(void)
{
    sigaction_t act = {0};
    sigaction_t old = {0};
    act.sa_handler = on_usr1;
    sigemptyset(&act.sa_mask);
    ASSERT(sigaction(SIGUSR1, &act, &old) == 0);

    kick_t k = { sys_getpid(), sys_gettid() };
    thread_t t;
    ASSERT(thread_create(&t, kick_thread, &k, NULL) == THREAD_SUCCESS);

    u64 start = clock_monotonic_ms();
    thread_sleep_ms(120);
    u64 took = clock_monotonic_ms() - start;
    thread_join(t, NULL);

    ASSERT(g_got_usr1 == 1);
    ASSERT(took >= 110);
    sigaction(SIGUSR1, &old, NULL);
    return true;
}

static void on_ill(int s) { (void)s; exit(99); }

static void *bad_pointer(void)
{
    char *m = (char *)sys_mmap(NULL, (size_t)4 << 20, PROT_READ | PROT_WRITE,
                               MAP_PRIVATE | MAP_ANON, -1, 0);
    return m ? m + ((size_t)2 << 20) + 128 : NULL;
}

static int child_free_invalid(void *arg)
{
    (void)arg;
    signal(SIGILL, on_ill);
    free(bad_pointer());
    return 0;
}

static int child_usable_size_invalid(void *arg)
{
    (void)arg;
    signal(SIGILL, on_ill);
    (void)malloc_usable_size(bad_pointer());
    return 0;
}

static bool test_alloc_fatal_errors(void)
{
    static char err[256];
    capture_t cap;

    ASSERT(capture_begin(&cap, 2));
    int st = run_in_child(child_free_invalid, NULL);
    capture_end(&cap, err, sizeof(err));
    ASSERT(st == 99);
    ASSERT_STR_EQ(err, "free(): invalid pointer\n");

    ASSERT(capture_begin(&cap, 2));
    st = run_in_child(child_usable_size_invalid, NULL);
    capture_end(&cap, err, sizeof(err));
    ASSERT(st == 99);
    ASSERT_STR_EQ(err, "malloc_usable_size(): invalid pointer\n");
    return true;
}

static int child_out_of_memory(void *arg)
{
    (void)arg;
    void *held = oom_begin();

    if (malloc(16) != NULL)                return 20;
    if (malloc((size_t)1 << 40) != NULL)   return 21;
    if (mutex_create(MUTEX_PLAIN) != NULL) return 22;

    dstr_t d = dstr_new("x");
    if (d.data != NULL)                    return 23;
    parr_t p = parr_new(NULL, 0);
    if (p.data != NULL)                    return 24;
    iarr_t i = iarr_new(NULL, 0);
    if (i.data != NULL)                    return 25;
    map_t m = map_new(8, NULL);
    if (m.entries != NULL || m.cap != 0)   return 26;

    thread_t t;
    if (thread_create(&t, noop_thread, NULL, NULL) != THREAD_NOMEM) return 27;

    oom_end(held);
    return 0;
}

static bool test_out_of_memory(void)
{
    int st_ = run_in_child_quiet(child_out_of_memory, NULL); if (st_ != 0) printf("  oom child status %d\n", st_); ASSERT(st_ == 0);
    return true;
}
#endif /* __linux__ */


static bool test_map_new_overflow(void)
{
    map_t m = map_new((size_t)1 << 62, NULL);
    ASSERT(m.entries == NULL && m.cap == 0);
    map_free(&m);
    return true;
}

static void run_core_tests(void)
{

    RUN_TEST(test_dstr_growth);
    RUN_TEST(test_dstr_numbers);
    RUN_TEST(test_dstr_null_guards);
    RUN_TEST(test_iarr_ops);
    RUN_TEST(test_parr_ops);
    RUN_TEST(test_parr_strings);
    RUN_TEST(test_mem_functions);
    RUN_TEST(test_str_functions);
    RUN_TEST(test_format_matrix);
    RUN_TEST(test_format_special_values);
#if defined(__linux__) || defined(__FreeBSD__)
    RUN_TEST(test_format_random_values);
    RUN_TEST(test_format_exact_large_output);
#endif
    RUN_TEST(test_format_misc);
#if defined(__linux__)
    RUN_TEST(test_cio_output);
    RUN_TEST(test_cio_parr_printing);
    RUN_TEST(test_cio_printf_sizes);
#endif
    RUN_TEST(test_mutex_validation);
    RUN_TEST(test_mutex_plain);
    RUN_TEST(test_mutex_recursive);
    RUN_TEST(test_mutex_errorcheck);
    RUN_TEST(test_mutex_scoped_macros);
    RUN_TEST(test_crt_lock_contention);
    RUN_TEST(test_clock);
    RUN_TEST(test_map_new_overflow);
#if defined(__linux__)
    RUN_TEST(test_atexit_order_and_limit);
    RUN_TEST(test_exit_variants);
    RUN_TEST(test_exit_reentrancy_guard);
    RUN_TEST(test_thread_exit_main);
    RUN_TEST(test_thread_validation_and_exit);
    RUN_TEST(test_tls_key_validation);
    RUN_TEST(test_thread_stack_too_large);
    RUN_TEST(test_thread_create_clone_failure);
    RUN_TEST(test_sleep_resumes_after_signal);
    RUN_TEST(test_alloc_fatal_errors);
    RUN_TEST(test_out_of_memory);
#endif
}
