static int call_vsnprintf(char *buf, size_t n, const char *fmt, ...)
{
    va_list ap;
    va_start(ap, fmt);
    int r = vsnprintf(buf, n, fmt, ap);
    va_end(ap);
    return r;
}

static bool test_format_misc(void)
{
    char b[64];

    int n = -1;
    snprintf(b, sizeof(b), "abc%n", &n);
    ASSERT(n == 3);

    signed char nc = -1;
    short ns = -1;
    long nl = -1;
    long long nll = -1;
    ssize_t nz = -1;
    intmax_t nj = -1;
    ptrdiff_t nt = -1;
    snprintf(b, sizeof(b), "ab%hhn", &nc);   ASSERT(nc == 2);
    snprintf(b, sizeof(b), "abc%hn", &ns);   ASSERT(ns == 3);
    snprintf(b, sizeof(b), "abcd%ln", &nl);  ASSERT(nl == 4);
    snprintf(b, sizeof(b), "a%lln", &nll);   ASSERT(nll == 1);
    snprintf(b, sizeof(b), "ab%zn", &nz);    ASSERT(nz == 2);
    snprintf(b, sizeof(b), "abc%jn", &nj);   ASSERT(nj == 3);
    snprintf(b, sizeof(b), "abcd%tn", &nt);  ASSERT(nt == 4);

    snprintf(b, sizeof(b), "x%n", (int *)0);
    snprintf(b, sizeof(b), "x%hhn", (signed char *)0);
    snprintf(b, sizeof(b), "x%hn", (short *)0);
    snprintf(b, sizeof(b), "x%ln", (long *)0);
    snprintf(b, sizeof(b), "x%lln", (long long *)0);
    snprintf(b, sizeof(b), "x%zn", (ssize_t *)0);
    snprintf(b, sizeof(b), "x%jn", (intmax_t *)0);
    snprintf(b, sizeof(b), "x%tn", (ptrdiff_t *)0);

    snprintf(b, sizeof(b), "%y");
    ASSERT_STR_EQ(b, "%y");
    snprintf(b, sizeof(b), "abc%");
    ASSERT_STR_EQ(b, "abc%");

    ASSERT(snprintf(NULL, 0, "%d-%s", 123, "abc") == 7);
    ASSERT(snprintf(b, 0, "hello") == 5);
    ASSERT(snprintf(b, 1, "hello") == 5 && b[0] == '\0');
    ASSERT(snprintf(b, 4, "hello") == 5);
    ASSERT_STR_EQ(b, "hel");
    ASSERT(call_vsnprintf(b, sizeof(b), "%d%%", 50) == 3);
    ASSERT_STR_EQ(b, "50%");
    return true;
}