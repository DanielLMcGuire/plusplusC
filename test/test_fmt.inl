static int g_fmt_fail = 0;
static char g_fmt_buf[8192];
static char g_fmt_big[60000];

static unsigned long long fnv1a(const char *s, size_t n)
{
    unsigned long long h = 1469598103934665603ULL;
    for (size_t i = 0; i < n; i++)
    {
        h ^= (unsigned char)s[i];
        h *= 1099511628211ULL;
    }
    return h;
}

#define CHECK_FMT(expected, fmt, ...) \
    do { \
        snprintf(g_fmt_buf, sizeof(g_fmt_buf), fmt __VA_OPT__(,) __VA_ARGS__); \
        if (strcmp(g_fmt_buf, (expected)) != 0) \
        { \
            printf("  [FMT] \"%s\": expected '%s', got '%s'\n", fmt, (expected), g_fmt_buf); \
            g_fmt_fail++; \
        } \
    } while (0)

#define CHECK_FMT_HASH(len, hash, fmt, ...) \
    do { \
        int n_ = snprintf(g_fmt_big, sizeof(g_fmt_big), fmt __VA_OPT__(,) __VA_ARGS__); \
        if (n_ != (len) || fnv1a(g_fmt_big, (size_t)n_) != (hash)) \
        { \
            printf("  [FMT] \"%s\": length %d (glibc %d), hash differs\n", fmt, n_, (len)); \
            g_fmt_fail++; \
        } \
    } while (0)

