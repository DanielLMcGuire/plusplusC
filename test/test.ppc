static int g_tests_run = 0;
static int g_tests_passed = 0;

#include "test_util.h"
#include "test_main.ppc"
#include "test_core.ppc"
#include "test_xxc.ppc"
#include "test_sys.ppc"
#include "test_proc.ppc"
#include "test_env.ppc"

int program(parr_t args)
{
    int helper = proc_test_startup(args);
    if (helper >= 0)
        return helper;
    
    run_main_tests();
    run_core_tests();
    run_xxc_tests();
    run_sys_tests();
    run_proc_tests();
    run_env_tests();

    if (g_tests_passed == g_tests_run)
    {
        printf(" SUCCESS: All %d tests passed!\n", g_tests_run);
        return 0;
    }
    printf(" FAILURE: %d of %d tests failed.\n", g_tests_run - g_tests_passed, g_tests_run);
    return 1;
}
