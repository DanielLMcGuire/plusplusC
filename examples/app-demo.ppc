#include <parr.h>
#include <dstr.h>
#include <cio.h>
#include <str.h>
#include <signal.h>
#include <atexit.h>
#include <atomic.h>

#include <class.pph>
#include <app.pph>
#include <ios.pph>

#define MINOR 1
#define MAJOR 0

CLASS(Demo, Application)
{
    BASE(Application)
    METHOD(bool, process_args, (void *self))
    FIELD(bool, showVersion)
    FIELD(bool, showAbout)
};

CLASS_EXPORT(Demo);

static volatile atomic_bool_t g_interrupted;
static volatile atomic_u8_t g_interrupt_count;

static void handle_sigint(int sig)
{
    (void)sig;
    u8 iInterrupt = atomic_u8_fetch_add(&g_interrupt_count, 1) + 1;
    bool bInterrupt = atomic_bool_load(&g_interrupted);
    if (iInterrupt == 1)
            while (!atomic_bool_cas(&g_interrupted, &bInterrupt, !bInterrupt)) {}
    else if (iInterrupt >= 2)
        _exit(130);
}

int program(parr_t csArgs)
{
    (void)csArgs;
    atomic_u8_init(&g_interrupt_count, 0);
    atomic_bool_init(&g_interrupted, false);
    if (signal(SIGINT, handle_sigint) == SIG_ERR)
        return 1;

#if defined(__GNUC__) || defined(__clang__)
    SCOPED_NEW(Demo, demo);
#else
    Demo *demo = NEW(Demo);
#endif
    if (demo == nullptr)
        return 1;

    Application *app = AS(Application, demo);

    CALL1(app, parse_args, &csArgs);

    int exit_code = 0;

    bool bInterrupt = atomic_bool_load(&g_interrupted);
    if (bInterrupt)
        exit_code = 130;
    else
        exit_code = CALL0(app, main);

#if !defined(__GNUC__) && !defined(__clang__)
    REMOVE(demo);
#endif

    bInterrupt = atomic_bool_load(&g_interrupted);
    
    if (bInterrupt && exit_code == 0)
        exit_code = 130;

    return exit_code;
}

METHOD_PROTO(Demo, void, configure_args, (void *self));
METHOD_PROTO(Demo, int, run, (void *self));
METHOD_PROTO(Demo, bool, process_args, (void *self));

CLASS_INFO(Demo, Application);

CONSTRUCTOR(Demo)
{
    SUPER_CTOR(self, Application);

    METHOD_LINK(base, Demo, configure_args);
    METHOD_LINK(base, Demo, run);
    METHOD_LINK(Demo, process_args);
}

DECONSTRUCTOR(Demo)
{
    SUPER_DTOR(self, Application);
}

IMPLEMENT(Demo, void, configure_args, (void *self))
{
    Demo *this = (Demo *)self;
    CALL2(this->base.args, add_flag, "version", "Print version");
    CALL2(this->base.args, add_flag, "about", "Print about info");
}

IMPLEMENT(Demo, int, run, (void *self))
{
    Demo *this = (Demo *)self;
    Application *app = AS(Application, this);

    if (!this->process_args(self)) return 1;

    if (this->showVersion) 
    {
        CALL3(cout(), fprintf, "%d.%d\n", MAJOR, MINOR);
        return 0;
    } 
    else if (this->showAbout)
    {
        CALL1(cout(), fprintln, "++C Demo");
        return 0;
    }
    
    CALL3(cout(), fprintf, "++C Demo %d.%d\n", MAJOR, MINOR);
    CALL0(app, print_help);

    return 0;
}

IMPLEMENT(Demo, bool, process_args, (void *self))
{
    Demo *this = (Demo *)self;
    this->showVersion = CALL1(this->base.args, get_bool, "version");
    this->showAbout = CALL1(this->base.args, get_bool, "about");

    if (this->showVersion || this->showAbout) return true;

    return true;
}
