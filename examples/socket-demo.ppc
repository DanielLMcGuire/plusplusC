#include <cio.h>
#include <str.h>
#include <mem.h>
#include <sig.h>
#include <atexit.h>
#include <atomic.h>

#include <ios.pph>
#include <app.pph>
#include <socket.pph>
#include <thread.pph>

CLASS(SocketDemo, Application)
{
    BASE(Application)
    
    METHOD(void, run_server, (void *self))
    METHOD(void, run_client, (void *self))
};

CLASS_EXPORT(SocketDemo);

static volatile atomic_bool_t g_interrupted = ATOMIC_INIT(false);
static volatile atomic_u8_t g_interrupt_count = ATOMIC_INIT(0);

static atomic_bool_t g_server_ready = ATOMIC_INIT(false);

static void handle_sigint(int sig)
{
    (void)sig;
    u8 iInterrupt = atomic_u8_fetch_add(&g_interrupt_count, 1) + 1;
    bool bInterrupt = atomic_bool_load(&g_interrupted);
    if (iInterrupt == 1)
            while (!atomic_bool_cas(&g_interrupted, &bInterrupt, !bInterrupt)) {}
    else if (iInterrupt >= 2)
        _exit(130);
}

static void *server_thread_func(void *arg)
{
    SocketDemo *self = (SocketDemo *)arg;
    CALL0(self, run_server);
    return nullptr;
}

static void *client_thread_func(void *arg)
{
    SocketDemo *self = (SocketDemo *)arg;

    while (!atomic_bool_load(&g_server_ready))
        thread_sleep_ms(10);

    CALL0(self, run_client);
    return nullptr;
}

int program(parr_t csArgs)
{
    (void)csArgs;
    atomic_u8_init(&g_interrupt_count, 0);
    atomic_bool_init(&g_interrupted, false);
    if (signal(SIGINT, handle_sigint) == SIG_ERR)
        return 1;

#if defined(__GNUC__) || defined(__clang__)
    SCOPED_NEW(SocketDemo, demo);
#else
    SocketDemo *demo = NEW(SocketDemo);
#endif
    if (demo == nullptr)
        return 1;

    Application *app = AS(Application, demo);

    CALL1(app, parse_args, &csArgs);

    int exit_code = 0;

    bool bInterrupt = atomic_bool_load(&g_interrupted);
    if (bInterrupt)
        exit_code = 130;
    else
        exit_code = CALL0(app, main);

#if !defined(__GNUC__) && !defined(__clang__)
    REMOVE(demo);
#endif

    bInterrupt = atomic_bool_load(&g_interrupted);
    
    if (bInterrupt && exit_code == 0)
        exit_code = 130;

    return exit_code;
}

METHOD_PROTO(SocketDemo, int, run, (void *self));
METHOD_PROTO(SocketDemo, void, run_server, (void *self));
METHOD_PROTO(SocketDemo, void, run_client, (void *self));

CLASS_INFO(SocketDemo, Application);

CONSTRUCTOR(SocketDemo)
{
    SUPER_CTOR(self, Application);

    METHOD_LINK(base, SocketDemo, run);
    
    METHOD_LINK(SocketDemo, run_server);
    METHOD_LINK(SocketDemo, run_client);
}

DECONSTRUCTOR(SocketDemo)
{
    SUPER_DTOR(self, Application);
}

IMPLEMENT(SocketDemo, int, run, (void *self))
{
    SocketDemo *this = (SocketDemo *)self;
    atomic_bool_store(&g_server_ready, false);

    Thread *server_thread = thread_new_fn(server_thread_func, this);
    Thread *client_thread = thread_new_fn(client_thread_func, this);

    CALL0(server_thread, start);
    CALL0(client_thread, start);

    CALL0(client_thread, join);
    CALL0(server_thread, join);

    REMOVE(client_thread);
    REMOVE(server_thread);

    return 0;
}

IMPLEMENT(SocketDemo, void, run_server, (void *self))
{
    (void)self;
    u16 port = 8080;
    CALL2(cout(), fprintf, "[Server] Starting server on port %d...\n", port);

    SocketStream *listener = tcp_listen(SOCK_INADDR_ANY, port, 5);
    
    if (listener == nullptr)
    {
        CALL2(cout(), fprintf, "[Server] Failed to bind/listen on port %d.\n", port);
        return;
    }

    CALL1(cout(), fprintln, "[Server] Waiting for a connection...");
    
    atomic_bool_store(&g_server_ready, true);

    sock_addr_in_t peer_addr;
    Stream *client = tcp_accept(listener, &peer_addr);

    if (client != nullptr)
    {
        CALL1(cout(), fprintln, "[Server] Client connected!");

        CALL1(client, fprint, "Welcome to the ++C Server!");

        char buf[256] = {0};
        i64 bytes = CALL2(client, read, buf, sizeof(buf) - 1);
        
        if (bytes > 0)
            CALL2(cout(), fprintf, "[Server] Received from client: %s\n", buf);

        REMOVE(client);
    }

    REMOVE(listener);
}

IMPLEMENT(SocketDemo, void, run_client, (void *self))
{
    (void)self;
    u16 port = 8080;
    const char* host = "127.0.0.1";
    
    CALL3(cout(), fprintf, "[Client] Connecting to %s:%d...\n", host, port);

    Stream *conn = tcp_connect(host, port);
    
    if (conn == nullptr)
    {
        CALL1(cout(), fprintln, "[Client] Connection failed.");
        return;
    }

    CALL1(cout(), fprintln, "[Client] Connected!");

    char buf[256] = {0};
    CALL2(conn, read, buf, sizeof(buf) - 1);
    CALL2(cout(), fprintf, "[Client] Server says: %s\n", buf);

    CALL1(conn, fprint, "Hello from ++C Client!");
}