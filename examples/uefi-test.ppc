#include <app.pph>
#include <files.pph>
#include <fs.pph>
#include <ios.pph>
#include <mems.pph>
#include <map.pph>
#include <clock.h>
#include <cio.h>
#include <str.h>
#include <mem.h>
#include <sys_uefi.h>

static int g_pass, g_fail;

#define CHECK(cond) \
    do { if (cond) g_pass++; \
         else { g_fail++; printf("  FAIL  %s  [line %d]\n", #cond, __LINE__); } } while (0)

typedef unsigned long long ull;

CLASS(IoTest, Application)
{
    BASE(Application)
};

CLASS_EXPORT(IoTest);
METHOD_PROTO(IoTest, int, run, (void *self));
CLASS_INFO(IoTest, Application);

CONSTRUCTOR(IoTest)
{
    SUPER_CTOR(self, Application);
    METHOD_LINK(base, IoTest, run);
}

DECONSTRUCTOR(IoTest) { SUPER_DTOR(self, Application); }

static bool file_starts_with_str(const char *path, const char *prefix)
{
    if (path == nullptr || prefix == nullptr) return false;
    SCOPED Stream *f = fopen_str(path, "r");
    if (f == nullptr) return false;
    char buf[64] = {0};
    size_t n = strlen(prefix);
    i64 got = CALL2(f, read, buf, n);
    return got == (i64)n && memcmp(buf, prefix, n) == 0;
}

static bool file_starts_with(FSPath *path, const char *prefix)
{
    if (path == nullptr || prefix == nullptr) return false;
    dstr_t pathStr = CALL0(path, data);
    bool ok = file_starts_with_str(pathStr.data, prefix);
    dstr_free(&pathStr);
    return ok;
}

static void test_clock(void)
{
    printf("[clock]\n");

    u64 t0 = clock_monotonic_ms();
    __uefi_stall_us(200000);
    u64 dt = clock_monotonic_ms() - t0;
    printf("  200 ms stall measured as %llu ms\n", (ull)dt);
    CHECK(dt >= 190 && dt <= 260);

    u64 a = clock_monotonic_ns(), b = clock_monotonic_ns();
    CHECK(b >= a);

    EFI_TIME now;
    CHECK(__uefi_get_time(&now));
    printf("  RTC: %04d-%02d-%02d %02d:%02d:%02d  unix=%llu\n",
           now.Year, now.Month, now.Day, now.Hour, now.Minute, now.Second, (ull)__uefi_unix_time());
    CHECK(now.Year >= 2024 && now.Month >= 1 && now.Month <= 12);
    CHECK(__uefi_unix_time() > 1700000000ull);
}

static void test_files(void)
{
    printf("[files]\n");
    char buf[16];
    dstr_t line;

    const char path[] = "io_test.txt";

    Stream *f = fopen_str(path, "w");
    CHECK(f != nullptr);
    if (f == nullptr) return;
    CALL1(f, fprintln, "hello from ++C");
    CALL2(f, fprintf, "n=%d\n", 42);
    CALL1(f, fprint, "tail");
    REMOVE(f);

    f = fopen_str(path, "r");
    CHECK(f != nullptr);
    freadline(f, &line);
    CHECK(strcmp(line.data, "hello from ++C") == 0);
    dstr_free(&line);
    CHECK(CALL0(f, tell) == 15);
    CHECK(CALL2(f, seek, 0, FS_SEEK_END) == 24);
    CHECK(CALL2(f, read, buf, 4) == 0);
    CHECK(CALL0(f, eof) == 1);
    CHECK(CALL2(f, seek, -4, FS_SEEK_END) == 20);
    CHECK(CALL0(f, eof) == 0);
    CHECK(CALL2(f, read, buf, 4) == 4 && memcmp(buf, "tail", 4) == 0);
    CHECK(CALL2(f, seek, 6, FS_SEEK_SET) == 6);
    CHECK(CALL2(f, read, buf, 4) == 4 && memcmp(buf, "from", 4) == 0);
    CHECK(CALL2(f, seek, 2, FS_SEEK_CUR) == 12);
    CHECK(CALL2(f, write, "x", 1) < 0);
    REMOVE(f);

    f = fopen_str(path, "a");
    CHECK(f != nullptr);
    CALL1(f, fprintln, "+appended");
    REMOVE(f);
    f = fopen_str(path, "r");
    CHECK(CALL2(f, seek, 0, FS_SEEK_END) == 34);
    REMOVE(f);

    f = fopen_str(path, "r+");
    CHECK(f != nullptr);
    CALL2(f, seek, 0, FS_SEEK_SET);
    CALL1(f, fprint, "HELLO");
    REMOVE(f);
    dstr_t pathStr = dstr_new(path);
    CHECK(file_starts_with(fs_path(pathStr), "HELLO from ++C"));
    dstr_free(&pathStr);

    f = fopen_str(path, "w");
    REMOVE(f);
    f = fopen_str(path, "r");
    CHECK(CALL2(f, seek, 0, FS_SEEK_END) == 0);
    REMOVE(f);

    CHECK(fopen_str("no_such_file.txt", "r") == nullptr);
    CHECK(fopen_str("no_such_dir/x.txt", "w") == nullptr);
    CHECK(fopen_str(path, "z") == nullptr);

    f = fopen_str("EFI/BOOT/BOOTX64.EFI", "r");
    CHECK(f != nullptr);
    if (f)
    {
        CHECK(CALL2(f, seek, 0, FS_SEEK_END) > 1000);
        REMOVE(f);
    }
    CHECK(file_starts_with_str("EFI/BOOT/BOOTX64.EFI", "MZ"));
    CHECK(file_starts_with_str("\\EFI\\BOOT\\BOOTX64.EFI", "MZ"));

    dstr_t nm = dstr_new("tmp_touch.txt");
    FSPath *p = fs_path(nm);
    dstr_free(&nm);
    CHECK(CALL0(p, touch));
    f = fopen_str("tmp_touch.txt", "r");
    CHECK(f != nullptr);
    REMOVE(f);
    CHECK(CALL0(p, remove));
    CHECK(fopen_str("tmp_touch.txt", "r") == nullptr);
    CHECK(!CALL0(p, remove));
    REMOVE(p);

    f = fopen_str(path, "w");
    CALL1(f, fprintln, "written by ++C running on bare metal");
    REMOVE(f);
}

static void test_other_classes(void)
{
    printf("[classes]\n");

    MemoryStream *ms = NEW(MemoryStream);
    Stream *s = AS(Stream, ms);
    CHECK(s != nullptr);
    CALL2(s, fprintf, "id=%d", 101);
    CALL2(s, seek, 0, FS_SEEK_SET);
    char buf[16] = {0};
    CHECK(CALL2(s, read, buf, 15) == 6 && strcmp(buf, "id=101") == 0);
    REMOVE(ms);

    Map *m = NEW(Map);
    CALL2(m, set, "k", (void *)(uintptr_t)42);
    CHECK(CALL1(m, contains, "k"));
    CHECK((uintptr_t)CALL1(m, get, "k") == 42);
    CALL1(m, remove, "k");
    CHECK(!CALL1(m, contains, "k"));
    REMOVE(m);
}

static void test_input(void)
{
    printf("[console input]\n");
    printf("  type your name, then Enter: ");
    dstr_t name;
    freadline(cin(), &name);
    printf("  hello, '%s' (%d chars)\n", name.data, (int)name.len);
    CHECK(name.len > 0);
    dstr_free(&name);
}

IMPLEMENT(IoTest, int, run, (void *self))
{
    (void)self;

    test_clock();
    test_files();
    test_other_classes();
    test_input();

    printf("\n%d passed, %d failed\n", g_pass, g_fail);
    return g_fail ? 1 : 0;
}

int program(parr_t csArgs)
{
    IoTest *t = NEW(IoTest);
    Application *app = AS(Application, t);

    CALL1(app, parse_args, &csArgs);
    int rc = CALL0(app, main);

    REMOVE(t);
    return rc;
}