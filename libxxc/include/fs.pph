#ifndef FS_PATH_H
#define FS_PATH_H

#include <def.h>
#include <class.pph>
#include <dstr.h>
#include <parr.h>

CLASS(FSPath)
{
    FIELD(parr_t, dsData)
    FIELD(bool, absolute)

    METHOD(void,     join,     (void *self, const char *path))
    METHOD(FSPath *, parent,   (void *self))
    METHOD(FSPath *, base,     (void *self))
    METHOD(FSPath *, relative, (void *self))
    METHOD(bool,     remove,   (void *self))
    METHOD(bool,     touch,    (void *self))
    METHOD(dstr_t,   data,     (void *self))
};

CLASS_EXPORT(FSPath);

METHOD_PROTO(FSPath, void, join, (void *self, const char *path));
METHOD_PROTO(FSPath, FSPath *, parent, (void *self));
METHOD_PROTO(FSPath, FSPath *, base, (void *self));
METHOD_PROTO(FSPath, FSPath *, relative, (void *self));
METHOD_PROTO(FSPath, bool, remove, (void *self));
METHOD_PROTO(FSPath, bool, touch, (void *self));
METHOD_PROTO(FSPath, dstr_t, data, (void *self));

FSPath *fs_path(dstr_t path);

#endif /* FS_PATH_H */