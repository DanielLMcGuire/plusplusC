#ifndef CLASS_H
#define CLASS_H

#include <def.h>
#include <alloc.h>
#include <atexit.h>
#include <cio.h>

typedef struct Class Class;

typedef void (*C_Constructor)(void *self);
typedef void (*C_Destructor)(void *self);

typedef struct {
    const Class *class;
} C_Header;


struct Class {
    const char *name;
    const Class *parent;

    size_t size;

    C_Constructor constructor;
    C_Destructor destructor;
    void (*init)(void);
};


static inline C_Header *c_header(void *object)
{
    return ((C_Header *)object) - 1;
}


static inline const C_Header *c_header_const(const void *object)
{
    return ((const C_Header *)object) - 1;
}

static inline void c_init_class(const Class *class)
{
    if (!class || !class->init)
        return;

    class->init();
}

static inline const Class *c_class(const void *object)
{
    if (!object)
        return NULL;

    const Class *class = c_header_const(object)->class;
    c_init_class(class);
    return class;
}

static inline void *c_new(const Class *class)
{
    C_Header *header;
    void *object;

    if (!class)
        return NULL;

    header = calloc(
        1,
        sizeof(C_Header) + class->size
    );

    if (!header)
        return NULL;

    header->class = class;

    object = header + 1;

    if (class->constructor)
        class->constructor(object);

    return object;
}

static inline void c_delete(void *object)
{
    C_Header *header;
    const Class *class;

    if (!object)
        return;

    header = c_header(object);
    class = header->class;

    if (class && class->destructor)
        class->destructor(object);

    free(header);
}

static inline void c_scoped_delete(void *p_object)
{
    if (!p_object)
        return;

    void *object = *(void **)p_object;
    if (object)
    {
        c_delete(object);
        *(void **)p_object = NULL;
    }
}

static inline int c_is_a(
    const void *object,
    const Class *class)
{
    const Class *current;

    if (!object || !class)
        return 0;

    current = c_class(object);

    while (current)
    {
        c_init_class(current);

        if (current == class)
            return 1;

        current = current->parent;
    }

    return 0;
}

#define AS(Type, object) \
    (c_is_a((object), &Type##__Class) \
        ? (Type *)(object) \
        : NULL)

#define CLASS_1(name)            \
    typedef struct name name;      \
    struct name

#define CLASS_2(name, parent)    \
    typedef struct name name;      \
    struct name


#define SELECT_CLASS(_1, _2, NAME, ...) NAME


#define CLASS(...) \
    SELECT_CLASS(__VA_ARGS__, CLASS_2, CLASS_1)(__VA_ARGS__)


#define BASE(Type) \
    Type base;


#define FIELD(Type, name) \
    Type name;

#define METHOD(return_type, name, params) \
    return_type (*name) params;

#define IMPLEMENT(Type, return_type, name, params) \
    return_type Type##__##name params

#define CONSTRUCTOR(Type) \
    void Type##__ctor(Type *self)


#define DECONSTRUCTOR(Type) \
    void Type##__dctor(Type *self)

#define SUPER_CTOR(self, parent) \
    parent##__ctor(&(self)->base)


#define SUPER_DTOR(self, parent) \
    parent##__dctor(&(self)->base)

#if defined(__clang__) && defined(_WIN32)
#define XXC_CLASS_WARNINGS_PUSH() \
    _Pragma("clang diagnostic push") \
    _Pragma("clang diagnostic ignored \"-Winconsistent-dllimport\"") \
    _Pragma("clang diagnostic ignored \"-Wdll-attribute-on-redeclaration\"")
#define XXC_CLASS_WARNINGS_POP() \
    _Pragma("clang diagnostic pop")
#else
#define XXC_CLASS_WARNINGS_PUSH()
#define XXC_CLASS_WARNINGS_POP()
#endif

#define CLASS_INFO_ROOT(Type) \
    XXC_DYN_EXPORT Class Type##__Class = { \
        .name = #Type, \
        .parent = NULL, \
        .size = sizeof(Type), \
        .constructor = (C_Constructor)Type##__ctor, \
        .destructor = (C_Destructor)Type##__dctor, \
        .init = NULL \
    }


#define CLASS_INFO(Type, parent_type) \
    XXC_CLASS_WARNINGS_PUSH() \
    XXC_CLASS_DECL(parent_type) \
    extern XXC_DYN_EXPORT Class Type##__Class; \
    static void Type##__Class_init(void) { \
        if (!Type##__Class.parent) \
            Type##__Class.parent = &parent_type##__Class; \
    } \
    XXC_DYN_EXPORT Class Type##__Class = { \
        .name = #Type, \
        .parent = NULL, \
        .size = sizeof(Type), \
        .constructor = (C_Constructor)Type##__ctor, \
        .destructor = (C_Destructor)Type##__dctor, \
        .init = Type##__Class_init \
    }; \
    XXC_CLASS_WARNINGS_POP()

#define NEW(Type) \
    ((Type *)c_new(&Type##__Class))


#define REMOVE(object) \
    c_delete((object))

#if defined(__GNUC__) || defined(__clang__)
#define SCOPED __attribute__((cleanup(c_scoped_delete)))

#define SCOPED_NEW(Type, name) \
    SCOPED Type *name = NEW(Type)
#elif _DEBUG
#define SCOPED_NEW(Type, name) \
    assert(false); \
    printf("Attempted to use scoped_new on MSVC in \"%s\", aborting...", __func__); \
    exit(-1)
#endif

#define IS_A(object, Type) \
    c_is_a((object), &Type##__Class)

#define CALL0(object, method) \
    ((object)->method((void *)(object)))

#define CALL1(object, method, a) \
    ((object)->method((void *)(object), (a)))

#define CALL2(object, method, a, b) \
    ((object)->method((void *)(object), (a), (b)))

#define CALL3(object, method, a, b, c) \
    ((object)->method((void *)(object), (a), (b), (c)))

#define CALL4(object, method, a, b, c, d) \
    ((object)->method((void *)(object), (a), (b), (c), (d)))

#define CALL5(object, method, a, b, c, d, e) \
    ((object)->method((void *)(object), (a), (b), (c), (d), (e)))

#define CALL6(object, method, a, b, c, d, e, f) \
    ((object)->method((void *)(object), (a), (b), (c), (d), (e), (f)))

#define CALL7(object, method, a, b, c, d, e, f, g) \
    ((object)->method((void *)(object), (a), (b), (c), (d), (e), (f), (g)))

#define CALL8(object, method, a, b, c, d, e, f, g, h) \
    ((object)->method((void *)(object), (a), (b), (c), (d), (e), (f), (g), (h)))

// WHAT? You need more than 8 arguments? Use a struct at this point...

#define __CMETHOD_FMT(Type, method) \
    Type##__##method

#define METHOD_LINK_2(Type, method) \
    self->method = __CMETHOD_FMT(Type, method)

#define METHOD_LINK_3(BaseField, Type, method) \
    self->BaseField.method = __CMETHOD_FMT(Type, method)

#define SELECT_METHOD_LINK(_1, _2, _3, NAME, ...) NAME

#define METHOD_LINK(...) \
    SELECT_METHOD_LINK(__VA_ARGS__, METHOD_LINK_3, METHOD_LINK_2)(__VA_ARGS__)

#if defined(_WIN32)
    #if defined(XXC_BUILDING_SHARED_LIB)
        #define XXC_CLASS_DECL(Type) extern XXC_DYN_EXPORT Class Type##__Class;
    #elif defined(XXC_USING_SHARED_LIB)
        #define XXC_CLASS_DECL(Type) extern XXC_DYN_IMPORT Class Type##__Class;
    #else
        #define XXC_CLASS_DECL(Type) extern Class Type##__Class;
    #endif
#else
    #define XXC_CLASS_DECL(Type) extern Class Type##__Class;
#endif

#define CLASS_EXPORT(Type) \
    XXC_CLASS_WARNINGS_PUSH() \
    XXC_CLASS_DECL(Type) \
    CONSTRUCTOR(Type); \
    DECONSTRUCTOR(Type); \
    XXC_CLASS_WARNINGS_POP()

#define METHOD_DECL(Type, method) \
    __CMETHOD_FMT(Type, method)

#define METHOD_PROTO(Type, return_type, name, params) \
    return_type __CMETHOD_FMT(Type, name) params

#endif