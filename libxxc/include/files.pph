#ifndef FILES_H
#define FILES_H

#include <def.h>
#include <class.pph>
#include <dstr.h>
#include <stream.pph>
#include <fs.pph>

CLASS(FileStream, Stream)
{
    BASE(Stream)
#if defined(_WIN32) || defined(__UEFI__)
    FIELD(void *, fd)
#else
    FIELD(int,  fd)
#endif
    FIELD(bool, owns_fd)
    FIELD(bool, eof_flag)
};

#if defined(_WIN32)
#include <windows.h>
#endif

CLASS_EXPORT(FileStream);

METHOD_PROTO(FileStream, i64, read, (void *self, void *buf, size_t n));
METHOD_PROTO(FileStream, i64, write, (void *self, const void *buf, size_t n));
METHOD_PROTO(FileStream, i64, seek, (void *self, i64 offset, int whence));
METHOD_PROTO(FileStream, i64, tell, (void *self));
METHOD_PROTO(FileStream, int, eof, (void *self));
METHOD_PROTO(FileStream, void, close, (void *self));

Stream *fopen(FSPath *path, const char *mode);
Stream *fopen_str(const char *path, const char *mode);

i64 fwrite(Stream *s, const char *str);
i64 freadline(Stream *s, dstr_t *out);

#endif /* FIO_H */