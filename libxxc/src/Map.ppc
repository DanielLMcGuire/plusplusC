#include <map.pph>

CLASS_INFO_ROOT(Map);

CONSTRUCTOR(Map)
{
    self->table = map_new(0, nullptr);

    METHOD_LINK(Map, set);
    METHOD_LINK(Map, get);
    METHOD_LINK(Map, try_get);
    METHOD_LINK(Map, contains);
    METHOD_LINK(Map, remove);

    METHOD_LINK(Map, set_bytes);
    METHOD_LINK(Map, get_bytes);
    METHOD_LINK(Map, try_get_bytes);
    METHOD_LINK(Map, contains_bytes);
    METHOD_LINK(Map, remove_bytes);

    METHOD_LINK(Map, len);
    METHOD_LINK(Map, clear);
    METHOD_LINK(Map, iterate);
    METHOD_LINK(Map, set_value_free);
}

DECONSTRUCTOR(Map)
{
    map_free(&self->table);
}

IMPLEMENT(Map, bool, set, (void *self, const char *key, void *value))
{
    Map *this = (Map *)self;
    return map_set_cstr(&this->table, key, value);
}

IMPLEMENT(Map, void *, get, (void *self, const char *key))
{
    Map *this = (Map *)self;
    return map_get_cstr(&this->table, key);
}

IMPLEMENT(Map, bool, try_get, (void *self, const char *key, void **out))
{
    Map *this = (Map *)self;
    return map_try_get_cstr(&this->table, key, out);
}

IMPLEMENT(Map, bool, contains, (void *self, const char *key))
{
    Map *this = (Map *)self;
    return map_contains_cstr(&this->table, key);
}

IMPLEMENT(Map, bool, remove, (void *self, const char *key))
{
    Map *this = (Map *)self;
    return map_remove_cstr(&this->table, key);
}

IMPLEMENT(Map, bool, set_bytes, (void *self, const char *key, size_t key_len, void *value))
{
    Map *this = (Map *)self;
    return map_set(&this->table, key, key_len, value);
}

IMPLEMENT(Map, void *, get_bytes, (void *self, const char *key, size_t key_len))
{
    Map *this = (Map *)self;
    return map_get(&this->table, key, key_len);
}

IMPLEMENT(Map, bool, try_get_bytes, (void *self, const char *key, size_t key_len, void **out))
{
    Map *this = (Map *)self;
    return map_try_get(&this->table, key, key_len, out);
}

IMPLEMENT(Map, bool, contains_bytes, (void *self, const char *key, size_t key_len))
{
    Map *this = (Map *)self;
    return map_contains(&this->table, key, key_len);
}

IMPLEMENT(Map, bool, remove_bytes, (void *self, const char *key, size_t key_len))
{
    Map *this = (Map *)self;
    return map_remove(&this->table, key, key_len);
}

IMPLEMENT(Map, size_t, len, (void *self))
{
    Map *this = (Map *)self;
    return map_len(&this->table);
}

IMPLEMENT(Map, void, clear, (void *self))
{
    Map *this = (Map *)self;
    map_clear(&this->table);
}

IMPLEMENT(Map, bool, iterate, (void *self, size_t *cursor, const char **key_out, size_t *key_len_out, void **value_out))
{
    Map *this = (Map *)self;
    return map_iterate(&this->table, cursor, key_out, key_len_out, value_out);
}

IMPLEMENT(Map, void, set_value_free, (void *self, void (*fn)(void *value)))
{
    Map *this = (Map *)self;
    this->table.value_free = fn;
}
