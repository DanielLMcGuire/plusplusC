#include <runnable.pph>

CLASS_INFO_ROOT(Runnable);

CONSTRUCTOR(Runnable)
{
    METHOD_LINK(Runnable, run);
}

DECONSTRUCTOR(Runnable)
{
    (void)self;
}

IMPLEMENT(Runnable, void *, run, (void *self))
{
    (void)self;
    return nullptr;
}
