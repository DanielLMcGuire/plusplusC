#include <socket.pph>

CLASS_INFO(SocketStream, Stream);

CONSTRUCTOR(SocketStream)
{
    SUPER_CTOR(self, Stream);

    self->fd       = SOCK_INVALID;
    self->owns_fd  = false;
    self->eof_flag = false;

    METHOD_LINK(base, SocketStream, read);
    METHOD_LINK(base, SocketStream, write);
    METHOD_LINK(base, SocketStream, seek);
    METHOD_LINK(base, SocketStream, tell);
    METHOD_LINK(base, SocketStream, eof);
    METHOD_LINK(base, SocketStream, close);
}

DECONSTRUCTOR(SocketStream)
{
    if (self->owns_fd && self->fd != SOCK_INVALID)
    {
        sock_close(self->fd);
        self->fd = SOCK_INVALID;
    }

    SUPER_DTOR(self, Stream);
}

IMPLEMENT(SocketStream, i64, read, (void *self, void *buf, size_t n))
{
    SocketStream *this = (SocketStream *)self;

    if (this->fd == SOCK_INVALID)
        return -1;

    if (buf == nullptr || n == 0)
        return 0;

    i64 r = sock_recv(this->fd, buf, n, 0);

    if (r == 0)
        this->eof_flag = true;

    return r;
}

IMPLEMENT(SocketStream, i64, write, (void *self, const void *buf, size_t n))
{
    SocketStream *this = (SocketStream *)self;

    if (this->fd == SOCK_INVALID)
        return -1;

    if (buf == nullptr || n == 0)
        return 0;

    return sock_send(this->fd, buf, n, 0);
}

IMPLEMENT(SocketStream, i64, seek, (void *self, i64 offset, int whence))
{
    (void)self;
    (void)offset;
    (void)whence;

    return -1;
}

IMPLEMENT(SocketStream, i64, tell, (void *self))
{
    (void)self;

    return -1;
}

IMPLEMENT(SocketStream, int, eof, (void *self))
{
    SocketStream *this = (SocketStream *)self;

    return this->eof_flag ? 1 : 0;
}

IMPLEMENT(SocketStream, void, close, (void *self))
{
    SocketStream *this = (SocketStream *)self;

    if (this->owns_fd && this->fd != SOCK_INVALID)
    {
        sock_close(this->fd);
        this->fd = SOCK_INVALID;
    }
}

Stream *tcp_connect(const char *host, u16 port)
{
    if (host == nullptr)
        return nullptr;

    /* GCOV_EXCL_START */
    if (!sock_init())
        return nullptr;
    /* GCOV_EXCL_STOP */

    sock_in_addr_t ip;

    if (!sock_inet_pton4(host, &ip))
        return nullptr;

    sock_t fd = sock_socket(SOCK_AF_INET, SOCK_STREAM_T, SOCK_IPPROTO_TCP);

    if (fd == SOCK_INVALID)
        return nullptr;

    sock_addr_in_t addr = sock_make_addr(0, port);
    addr.sin_addr = ip;

    if (sock_connect(fd, &addr) != 0)
    {
        sock_close(fd);
        return nullptr;
    }

    SocketStream *ss = NEW(SocketStream);

    if (ss == nullptr)
    {
        sock_close(fd);
        return nullptr;
    }

    ss->fd      = fd;
    ss->owns_fd = true;

    return (Stream *)ss;
}

SocketStream *tcp_listen(u32 bind_addr, u16 port, i32 backlog)
{
    /* GCOV_EXCL_START */
    if (!sock_init())
        return nullptr;
    /* GCOV_EXCL_STOP */

    sock_t fd = sock_socket(SOCK_AF_INET, SOCK_STREAM_T, SOCK_IPPROTO_TCP);

    if (fd == SOCK_INVALID)
        return nullptr;

    sock_set_reuseaddr(fd, true);

    sock_addr_in_t addr = sock_make_addr(bind_addr, port);

    if (sock_bind(fd, &addr) != 0)
    {
        sock_close(fd);
        return nullptr;
    }

    /* GCOV_EXCL_START */
    if (sock_listen(fd, backlog) != 0)
    {
        sock_close(fd);
        return nullptr;
    }
    /* GCOV_EXCL_STOP */

    SocketStream *ss = NEW(SocketStream);

    if (ss == nullptr)
    {
        sock_close(fd);
        return nullptr;
    }

    ss->fd      = fd;
    ss->owns_fd = true;

    return ss;
}

Stream *tcp_accept(SocketStream *listener, sock_addr_in_t *out_peer)
{
    if (listener == nullptr || listener->fd == SOCK_INVALID)
        return nullptr;

    sock_t fd = sock_accept(listener->fd, out_peer);

    if (fd == SOCK_INVALID)
        return nullptr;

    SocketStream *ss = NEW(SocketStream);

    if (ss == nullptr)
    {
        sock_close(fd);
        return nullptr;
    }

    ss->fd      = fd;
    ss->owns_fd = true;

    return (Stream *)ss;
}
