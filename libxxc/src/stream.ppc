#include <stream.pph>
#include <str.h>
#include <mem.h>

CLASS_INFO_ROOT(Stream);

CONSTRUCTOR(Stream)
{
    __crt_lock_init(&self->lock);
    METHOD_LINK(Stream, read);
    METHOD_LINK(Stream, write);
    METHOD_LINK(Stream, seek);
    METHOD_LINK(Stream, tell);
    METHOD_LINK(Stream, eof);
    METHOD_LINK(Stream, close);

    METHOD_LINK(Stream, fprint);
    METHOD_LINK(Stream, fprintln);
    METHOD_LINK(Stream, fvprintf);
    METHOD_LINK(Stream, fprintf);
}

DECONSTRUCTOR(Stream)
{
    (void)self;
}

IMPLEMENT(Stream, i64, read, (void *self, void *buf, size_t n))
{
    (void)self;
    (void)buf;
    (void)n;

    return -1;
}

IMPLEMENT(Stream, i64, write, (void *self, const void *buf, size_t n))
{
    (void)self;
    (void)buf;
    (void)n;

    return -1;
}

IMPLEMENT(Stream, i64, seek, (void *self, i64 offset, int whence))
{
    (void)self;
    (void)offset;
    (void)whence;

    return -1;
}

IMPLEMENT(Stream, i64, tell, (void *self))
{
    (void)self;

    return -1;
}

IMPLEMENT(Stream, int, eof, (void *self))
{
    (void)self;

    return 1;
}

IMPLEMENT(Stream, void, close, (void *self))
{
    (void)self;
}

IMPLEMENT(Stream, i64, fprint, (void *self, const char *str))
{
    Stream *this = (Stream *)self;
    if (!str) return 0;
    return this->write(self, str, strlen(str));
}

IMPLEMENT(Stream, i64, fprintln, (void *self, const char *str))
{
    Stream *this = (Stream *)self;
    
    if (!str) 
        return this->write(self, "\n", 1);

    size_t len = strlen(str);
    size_t total = len + 1;
    char *buf = NULL;
    bool owns_buf = false;

    if (total < STREAM_STACK_BUF_SIZE) 
    {
        buf = alloca(total);
    } 
    else 
    {
        buf = (char *)malloc(total);
        owns_buf = true;
    }

    if (!buf) 
        return -1;

    memcpy(buf, str, len);
    buf[len] = '\n';

    i64 written = this->write(self, buf, total);

    if (owns_buf) 
        free(buf);

    return written;
}

IMPLEMENT(Stream, int, fvprintf, (void *self, const char *fmt, va_list args))
{
    Stream *this = (Stream *)self;
    va_list args_copy;
    va_copy(args_copy, args);

    int len = vsnprintf(NULL, 0, fmt, args);
    /* GCOV_EXCL_START */
    if (len < 0)
    {
        va_end(args_copy);
        return len;
    }
    /* GCOV_EXCL_STOP */

    size_t size = (size_t)len + 1;
    char *buf = NULL;
    bool owns_buf = false;

    if (size < STREAM_STACK_BUF_SIZE) 
    {
        buf = alloca(size);
    } 
    else 
    {
        buf = (char *)malloc(size);
        owns_buf = true;
    }

    if (buf) 
    {
        vsnprintf(buf, size, fmt, args_copy);
        
        this->write(self, buf, (size_t)len);
    }

    if (owns_buf) 
        free(buf);

    va_end(args_copy);
    return len;
}

IMPLEMENT(Stream, int, fprintf, (void *self, const char *fmt, ...))
{
    Stream *this = (Stream *)self;
    va_list args;
    va_start(args, fmt);
    int ret = this->fvprintf(self, fmt, args);
    va_end(args);
    return ret;
}