#include <files.pph>
#include <alloc.h>
#include <str.h>
#include <cio.h>

#if defined(_WIN32)
#include <windows.h>
#endif

#if defined(__linux__) || defined(__FreeBSD__)
#include <xxc_sys.h>
#endif

#if defined(__UEFI__)
#include <sys_uefi.h>
#endif

CLASS_INFO(FileStream, Stream);

CONSTRUCTOR(FileStream)
{
    SUPER_CTOR(self, Stream);

#if defined(_WIN32)
    self->fd = INVALID_HANDLE_VALUE;
#elif defined(__UEFI__)
    self->fd = NULL;
#else
    self->fd = -1;
#endif

    self->owns_fd  = false;
    self->eof_flag  = false;

    METHOD_LINK(base, FileStream, read);
    METHOD_LINK(base, FileStream, write);
    METHOD_LINK(base, FileStream, seek);
    METHOD_LINK(base, FileStream, tell);
    METHOD_LINK(base, FileStream, eof);
    METHOD_LINK(base, FileStream, close);
}

DECONSTRUCTOR(FileStream)
{
#if defined(_WIN32)

    if (self->owns_fd && self->fd && self->fd != INVALID_HANDLE_VALUE)
        CloseHandle(self->fd);

    self->fd = INVALID_HANDLE_VALUE;

#elif defined(__UEFI__)

    if (self->owns_fd && self->fd)
        __uefi_fclose(self->fd);

    self->fd = NULL;

#elif defined(__linux__) || defined(__FreeBSD__)

    if (self->owns_fd && self->fd >= 0)
        sys_close(self->fd);

    self->fd = -1;

#endif

    SUPER_DTOR(self, Stream);
}

IMPLEMENT(FileStream, i64, read, (void *self, void *buf, size_t n))
{
    FileStream *this = (FileStream *)self;
    i64 result = -1;

    __crt_lock_acquire(&this->base.lock);

#if defined(_WIN32)
    if (!this->fd || this->fd == INVALID_HANDLE_VALUE) goto done;
    if (!buf || n == 0) { result = 0; goto done; }

    DWORD request = n > (size_t)MAXDWORD ? MAXDWORD : (DWORD)n;
    DWORD bytes_read = 0;

    if (!ReadFile(this->fd, buf, request, &bytes_read, NULL))
    {
        DWORD error = GetLastError();
        if (error == ERROR_BROKEN_PIPE || error == ERROR_HANDLE_EOF)
        {
            this->eof_flag = true;
            result = 0;
        }
        goto done;
    }

    if (bytes_read == 0) this->eof_flag = true;
    result = (i64)bytes_read;

#elif defined(__UEFI__)
    if (!this->fd) goto done;
    if (!buf || n == 0) { result = 0; goto done; }
    result = __uefi_fread(this->fd, buf, n);
    if (result == 0) this->eof_flag = true;

#elif defined(__linux__) || defined(__FreeBSD__)
    long r = sys_read(this->fd, buf, n);
    if (r == 0) this->eof_flag = true;
    result = r;
#endif

done:
    __crt_lock_release(&this->base.lock);
    return result;
}

IMPLEMENT(FileStream, i64, write, (void *self, const void *buf, size_t n))
{
    FileStream *this = (FileStream *)self;
    i64 result = -1;

    __crt_lock_acquire(&this->base.lock);

#if defined(_WIN32)
    if (!this->fd || this->fd == INVALID_HANDLE_VALUE) goto done;
    if (!buf || n == 0) { result = 0; goto done; }

    DWORD request = n > (size_t)MAXDWORD ? MAXDWORD : (DWORD)n;
    DWORD bytes_written = 0;

    if (WriteFile(this->fd, buf, request, &bytes_written, NULL))
        result = (i64)bytes_written;

#elif defined(__UEFI__)
    if (!this->fd) goto done;
    if (!buf || n == 0) { result = 0; goto done; }
    result = __uefi_fwrite(this->fd, buf, n);

#elif defined(__linux__) || defined(__FreeBSD__)
    result = sys_write(this->fd, buf, n);
#endif

done:
    __crt_lock_release(&this->base.lock);
    return result;
}

IMPLEMENT(FileStream, i64, seek, (void *self, i64 offset, int whence))
{
    FileStream *this = (FileStream *)self;
    i64 result = -1;

    __crt_lock_acquire(&this->base.lock);

#if defined(_WIN32)
    if (!this->fd || this->fd == INVALID_HANDLE_VALUE) goto done;
    DWORD method;
    switch (whence)
    {
        case FS_SEEK_SET: method = FILE_BEGIN; break;
        case FS_SEEK_CUR: method = FILE_CURRENT; break;
        case FS_SEEK_END: method = FILE_END; break;
        default: goto done;
    }

    LARGE_INTEGER distance, position;
    distance.QuadPart = offset;
    if (SetFilePointerEx(this->fd, distance, &position, method))
    {
        this->eof_flag = false;
        result = (i64)position.QuadPart;
    }

#elif defined(__UEFI__)
    if (!this->fd) goto done;
    result = __uefi_fseek(this->fd, offset, whence);
    if (result >= 0) this->eof_flag = false;

#elif defined(__linux__) || defined(__FreeBSD__)
    long r = sys_lseek(this->fd, offset, whence);
    if (r >= 0) this->eof_flag = false;
    result = r;
#endif

done:
    __crt_lock_release(&this->base.lock);
    return result;
}

IMPLEMENT(FileStream, i64, tell, (void *self))
{
    FileStream *this = (FileStream *)self;
    i64 result = -1;

    __crt_lock_acquire(&this->base.lock);

#if defined(_WIN32)
    if (!this->fd || this->fd == INVALID_HANDLE_VALUE) goto done;
    LARGE_INTEGER zero, position;
    zero.QuadPart = 0;
    if (SetFilePointerEx(this->fd, zero, &position, FILE_CURRENT))
        result = (i64)position.QuadPart;
#elif defined(__UEFI__)
    if (!this->fd) goto done;
    result = __uefi_ftell(this->fd);
#elif defined(__linux__) || defined(__FreeBSD__)
    result = sys_lseek(this->fd, 0, FS_SEEK_CUR);
#endif

done:
    __crt_lock_release(&this->base.lock);
    return result;
}

IMPLEMENT(FileStream, int, eof, (void *self))
{
    FileStream *this = (FileStream *)self;
    __crt_lock_acquire(&this->base.lock);
    int result = this->eof_flag ? 1 : 0;
    __crt_lock_release(&this->base.lock);
    return result;
}

IMPLEMENT(FileStream, void, close, (void *self))
{
    FileStream *this = (FileStream *)self;
    __crt_lock_acquire(&this->base.lock);

#if defined(_WIN32)
    if (this->owns_fd && this->fd && this->fd != INVALID_HANDLE_VALUE)
    {
        CloseHandle(this->fd);
        this->fd = INVALID_HANDLE_VALUE;
    }
#elif defined(__UEFI__)
    if (this->owns_fd && this->fd)
    {
        __uefi_fclose(this->fd);
        this->fd = NULL;
    }
#elif defined(__linux__) || defined(__FreeBSD__)
    if (this->owns_fd && this->fd >= 0)
    {
        sys_close(this->fd);
        this->fd = -1;
    }
#endif

    __crt_lock_release(&this->base.lock);
}

Stream *fopen(const char *path, const char *mode)
{
    if (!path || !mode || !mode[0])
        return NULL;

#if defined(_WIN32)

    DWORD access;
    DWORD creation;

    switch (mode[0])
    {
        case 'r':
            access = mode[1] == '+'
                ? GENERIC_READ | GENERIC_WRITE
                : GENERIC_READ;

            creation = OPEN_EXISTING;
            break;

        case 'w':
            access = mode[1] == '+'
                ? GENERIC_READ | GENERIC_WRITE
                : GENERIC_WRITE;

            creation = CREATE_ALWAYS;
            break;

        case 'a':
            access = mode[1] == '+'
                ? GENERIC_READ | FILE_APPEND_DATA
                : FILE_APPEND_DATA;

            creation = OPEN_ALWAYS;
            break;

        default:
            return NULL;
    }

    HANDLE handle = CreateFileA(
        path,
        access,
        FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
        NULL,
        creation,
        FILE_ATTRIBUTE_NORMAL,
        NULL
    );

    if (handle == INVALID_HANDLE_VALUE)
        return NULL;

    FileStream *fs = NEW(FileStream);

    if (!fs)
    {
        CloseHandle(handle);
        return NULL;
    }

    fs->fd       = handle;
    fs->owns_fd  = true;
    fs->eof_flag = false;

    return (Stream *)fs;

#elif defined(__UEFI__)

    if (mode[0] != 'r' && mode[0] != 'w' && mode[0] != 'a')
        return NULL;

    void *h = __uefi_fopen(path, mode);

    if (!h)
        return NULL;

    FileStream *fs = NEW(FileStream);

    if (!fs)
    {
        __uefi_fclose(h);
        return NULL;
    }

    fs->fd       = h;
    fs->owns_fd  = true;
    fs->eof_flag = false;

    return (Stream *)fs;

#elif defined(__linux__) || defined(__FreeBSD__)

    int flags;

    switch (mode[0])
    {
        case 'r':
            flags = mode[1] == '+'
                ? O_RDWR
                : O_RDONLY;
            break;

        case 'w':
            flags = (mode[1] == '+'
                ? O_RDWR
                : O_WRONLY) | O_CREAT | O_TRUNC;
            break;

        case 'a':
            flags = (mode[1] == '+'
                ? O_RDWR
                : O_WRONLY) | O_CREAT | O_APPEND;
            break;

        default:
            return NULL;
    }

    long fd = sys_openat(
        AT_FDCWD,
        path,
        flags,
        0666
    );

    if (fd < 0)
        return NULL;

    FileStream *fs = NEW(FileStream);

    if (!fs)
    {
        sys_close((int)fd);
        return NULL;
    }

    fs->fd       = (int)fd;
    fs->owns_fd  = true;
    fs->eof_flag = false;

    return (Stream *)fs;

#else

    (void)path;
    (void)mode;

    return NULL;

#endif
}

static FileStream *g_stdin_stream;
static FileStream *g_stdout_stream;
static FileStream *g_stderr_stream;

#ifdef _WIN32
#include <windows.h>

void xxc_io_init(void)
{
    g_stdin_stream = NEW(FileStream);
    g_stdout_stream = NEW(FileStream);
    g_stderr_stream  = NEW(FileStream);
    g_stdin_stream->fd  = GetStdHandle(STD_INPUT_HANDLE);
    g_stdout_stream->fd = GetStdHandle(STD_OUTPUT_HANDLE);
    g_stderr_stream->fd = GetStdHandle(STD_ERROR_HANDLE);
    g_stdin_stream->owns_fd  = false;
    g_stdout_stream->owns_fd = false;
    g_stderr_stream->owns_fd = false;
}

#elif defined(__UEFI__)

void xxc_io_init(void)
{
    g_stdout_stream = NEW(FileStream);
    g_stderr_stream = NEW(FileStream);
    g_stdin_stream  = NEW(FileStream);

    g_stdout_stream->fd = UEFI_STDOUT;
    g_stderr_stream->fd = UEFI_STDERR;
    g_stdin_stream->fd  = UEFI_STDIN;

    g_stdout_stream->owns_fd = false;
    g_stderr_stream->owns_fd = false;
    g_stdin_stream->owns_fd  = false;
}

#elif defined(__linux__) || defined(__FreeBSD__)

void xxc_io_init(void)
{
    g_stdout_stream = NEW(FileStream);
    g_stderr_stream = NEW(FileStream);
    g_stdin_stream  = NEW(FileStream);

    g_stdout_stream->fd = 1;
    g_stderr_stream->fd = 2;
    g_stdin_stream->fd  = 0;

    g_stdout_stream->owns_fd = false;
    g_stderr_stream->owns_fd = false;
    g_stdin_stream->owns_fd = false;
}

#endif

Stream *cin(void) 
{ 
    return (Stream *)g_stdin_stream; 
}
Stream *cout(void) 
{ 
    return (Stream *)g_stdout_stream; 
}
Stream *cerr(void) 
{ 
    return (Stream *)g_stderr_stream; 
}

i64 fwrite(Stream *s, const char *str)
{
    if (!s || !str)
        return -1;

    return CALL2(s, write, str, strlen(str));
}


i64 freadline(Stream *s, dstr_t *out)
{
    if (!s || !out)
        return -1;

    *out = dstr_new("");

    i64 total = 0;
    char c;

    for (;;)
    {
        i64 r = CALL2(s, read, &c, 1);

        if (r <= 0)
            break;

        total++;

        if (c == '\n')
            break;

        dstr_append_char(out, c);
    }

    if (out->len > 0 && out->data[out->len - 1] == '\r')
    {
        out->data[out->len - 1] = '\0';
        out->len--;
    }

    return total;
}